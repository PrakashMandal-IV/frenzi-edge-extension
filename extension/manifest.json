{
  "manifest_version": 3,
  "name": "Frenzi",
  "version": "1.0.0",
  "description": "Lets your Frenzi companion browse in a window of her own in this browser, with your sign-ins. She only uses the tabs she opens.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Frenzi",
    "default_icon": {
      "128": "icon.png"
    }
  }
}
